{
  "name": "godson-marketplace",
  "private": true,
  "version": "1.0.0",
  "description": "GODSON MARKETPLACE — Le marché gabonais, à portée de clic.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "prebuild": "node scripts/generate-sitemap.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "icons": "node scripts/generate-icons.mjs",
    "brand-icons": "node scripts/generate-brand-icons.mjs",
    "demo-images": "node scripts/generate-demo-images.mjs",
    "test:api": "node tests/api.test.mjs",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "test:e2e:install": "playwright install chromium",
    "cap:build": "npm run build && npx cap copy android",
    "cap:open": "npx cap open android",
    "apk:debug": "npm run build && npx cap copy android && (cd android && ./gradlew assembleDebug)"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "@capacitor/geolocation": "^7.1.8",
    "@sentry/react": "^11.8.0",
    "@supabase/supabase-js": "^2.49.4",
    "@vercel/analytics": "^2.0.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5"
  },
  "overrides": {
    "esbuild": "^0.25.12"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.64.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.18",
    "vite-plugin-pwa": "^0.20.5"
  }
}
