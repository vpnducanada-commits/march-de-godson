# GODSON MARKETPLACE — modèle de variables d'environnement
# Copiez ce fichier en .env et renseignez vos valeurs.
# Récupérez ces clés dans le tableau de bord Supabase → Project Settings → API.
# N'utilisez que la clé PUBLISHABLE (publique) ici. La clé SECRET (service_role) est
# strictement réservée à un environnement serveur et ne doit jamais être exposée au navigateur.
VITE_SUPABASE_URL=https://VOTRE-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_VOTRE_CLE
# Domaine public final (sitemap + balises og:/twitter: de partage).
# À remplacer par votre domaine une fois l'hébergement + DNS en place.
VITE_SITE_URL=https://votre-domaine.com
